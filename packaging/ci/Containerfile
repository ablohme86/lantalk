# The Linux build machine for .github/workflows/release.yml, run with podman
# on the self-hosted runner (label lantalk-linux). Ubuntu 22.04 keeps the
# tarball's glibc requirement at 2.35. Qt comes from the Qt Company's binaries
# rather than Ubuntu's packages so the install step can bundle it into the
# tarball. Built once and kept until this file changes.
FROM docker.io/library/ubuntu:22.04

ARG QT_VERSION=6.8.3
ENV DEBIAN_FRONTEND=noninteractive

# The X11/xcb libraries are what the bundled Qt platform plugin links
# against; the deploy step needs them present to resolve its dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build ca-certificates file python3-pip \
        libgl-dev libegl-dev libxkbcommon-dev libxkbcommon-x11-0 \
        libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 \
        libx11-xcb1 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
        libxcb-render-util0 libxcb-image0 libxcb-shape0 libxcb-randr0 \
        libxcb-xinerama0 libxcb-xkb1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir aqtinstall \
    && aqt install-qt linux desktop "${QT_VERSION}" linux_gcc_64 -O /opt/qt \
    && rm -rf /root/.cache aqtinstall.log

ENV CMAKE_PREFIX_PATH=/opt/qt/${QT_VERSION}/gcc_64
